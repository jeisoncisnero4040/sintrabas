# Opcional. Se interpreta respecto a la raíz del backend o admite una ruta absoluta.
# SQLITE_PATH=data/sintrabas.sqlite

# Los orígenes públicos se definen en .env.development y .env.production.
# Deja AUTH_ORIGIN fuera de .env.local para conservar los valores por entorno.
# La cookie usa Secure por defecto al ejecutar npm start.
# AUTH_SECURE_COOKIE=false

# OAuth para Google y Facebook. Cada par activa su proveedor.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# META_APP_ID=
# META_APP_SECRET=
# META_GRAPH_VERSION=v26.0
